# ── Monitored targets ─────────────────────────────────────────────
# Only the ones you set get polled. Start with as many as you've provisioned.

# Neon Postgres  → Dashboard → Connection Details (include ?sslmode=require)
NEON_DSN=postgresql://user:pw@ep-xxx.neon.tech/neondb?sslmode=require

# Supabase Postgres (a monitored target — a second Postgres in the fleet,
# unrelated to any metrics storage)
SUPA_DSN=postgresql://postgres:pw@HOST:5432/postgres?sslmode=require

# MongoDB Atlas M0 → Connect → Drivers → connection string
# (two logical targets, 'orders' and 'catalog', share this cluster URI)
MONGO_URI=mongodb+srv://user:pw@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority

# Upstash Redis → Database → connect (use the rediss:// URL, TLS)
REDIS_CACHE_URL=rediss://default:pw@xxx.upstash.io:6379
REDIS_SESSION_URL=rediss://default:pw@yyy.upstash.io:6379

# ── Agent (Phase 4 — not needed yet) ──────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
